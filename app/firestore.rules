rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Any signed-in user can read profile info (needed to show group members'
      // display name + avatar color in the Groups list, and to look up a
      // member's publicKey when syncing group encryption keys). Writes are
      // still restricted to the user's own document.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
      && request.resource.data.ownerId == request.auth.uid
      && request.auth.uid in request.resource.data.memberIds;

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        ||
        (
          !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.name == resource.data.name
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
        )
      );

      // Group owner can delete the group.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      match /memberKeys/{uid} {
        // Each member's copy of the group's symmetric key, wrapped with their
        // own public key. Only the group owner's device writes these (when
        // creating the group or syncing a new member); any signed-in member
        // can read (they can only decrypt their own entry anyway, since it's
        // wrapped with their personal key).
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /activities/{activityId} {
      // Weekly prompts / activities assigned to a user. Not scoped tighter
      // than "signed in" yet since there's no server-side notion of group
      // membership check here -- fine for this base build.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /activity_responses/{responseId} {
      // A member submitting their (encrypted) response to an activity.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
